# Copiez ce fichier en .env (ignoré par Git). Aucune variable n'a de préfixe.
# Toutes les variables « obligatoires » doivent être présentes : sinon l'API refuse de démarrer.

# ============================================================ OBLIGATOIRES

# ---------- Environnement
# "dev" ou "prod"
APP_ENV=dev
DATABASE_URL=sqlite:///./gyblood.db
# PostgreSQL (Render, Supabase...) : DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/gyblood

# ---------- Adresses
# URL publique de l'API : sert à la redirection Google et aux liens d'images (affiches de campagne).
# Émulateur Android : http://10.0.2.2:8080 — vrai téléphone : http://IP_DU_PC:8080
PUBLIC_BASE_URL=http://10.0.2.2:8080
# Adresse où l'application mobile est rappelée après la connexion Google (schéma déclaré côté MAUI)
MOBILE_CALLBACK_URL=gyblood://auth
# Préfixe des routes (doit correspondre à l'adresse de base du mobile : http://.../api/v1/)
API_PREFIX=/api/v1

# ---------- Sécurité
# En production : 32 caractères aléatoires au minimum
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
# Validité du « state » de la connexion Google et du code rendu à l'application (minutes)
OAUTH_STATE_MINUTES=10
AUTH_CODE_MINUTES=2

# ---------- Recherche de donneurs
# Un donneur est « connecté » s'il a envoyé un signal depuis moins de ... minutes
PRESENCE_WINDOW_MINUTES=5
MAX_SEARCH_RADIUS_KM=50
# Rayon utilisé quand le patient n'en précise pas (km)
DEFAULT_SEARCH_RADIUS_KM=10
# Nombre de donneurs examinés, puis nombre maximal renvoyé
SEARCH_CANDIDATE_LIMIT=500
SEARCH_MAX_RESULTS=50

# ---------- Pagination des listes
PAGE_DEFAULT_SIZE=20
PAGE_MAX_SIZE=100

# ---------- Règles métier
# Délai de repos entre deux dons tant que la règle du sexe n'est pas renseignée (jours)
DEFAULT_MIN_DAYS_BETWEEN_DONATIONS=56
# Frais d'entretien et d'examens (FCFA) tant que la structure n'a pas fixé son tarif
DEFAULT_HOSPITAL_FEE=5000
# Commission de la plateforme, prélevée sur le montant payé par le patient (%)
PLATFORM_FEE_PERCENT=5
# Montant minimum d'un financement de campagne (FCFA)
MIN_FUNDING_AMOUNT=500

# ---------- Paiement
# "sandbox" (simulé) tant qu'aucun agrégateur n'est branché. Interdit en production.
PAYMENT_PROVIDER=sandbox
SANDBOX_AUTO_CONFIRM=true
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

# ---------- Données de test
# Mot de passe de tous les comptes de démonstration (python seed_data.py)
DEMO_PASSWORD=Demo-1234

# ---------- Fichiers envoyés (documents de groupe sanguin, affiches de campagne)
UPLOAD_DIR=./uploads
# Taille maximale en octets (5242880 = 5 Mo)
MAX_DOCUMENT_BYTES=5242880
# Durée de mise en cache des images par le téléphone (secondes)
IMAGE_CACHE_SECONDS=3600

# ---------- Services externes
# Connexion Google : adresses des services, permissions demandées, délai d'attente (secondes)
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_SCOPE=openid email profile
EXTERNAL_TIMEOUT_SECONDS=10


# ============================================================ FACULTATIVES
# Vides = fonction désactivée

# Compte administrateur créé au démarrage s'il n'existe pas (mot de passe de 8 caractères minimum).
# Attention : modifier ces valeurs ne change pas un administrateur déjà créé.
# Ils sont aussi exigés par `python seed_data.py`.
ADMIN_EMAIL=admin@gyblood.test
ADMIN_PASSWORD=ChangezMoi-2026

# Connexion Google : client OAuth de type « Application Web » (console Google Cloud).
# URI de redirection autorisé : <PUBLIC_BASE_URL>/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notifications push (nécessite firebase-admin) : chemin du fichier JSON du compte de service Firebase
FCM_CREDENTIALS_FILE=